
(include 'widgets/networker.yuck')

(defwindow networker [monitor popup-x popup-y]
  :monitor monitor
  :stacking 'overlay'
  :focusable 'ondemand'
  :exclusive false
  :geometry (geometry
              :x popup-x
              :y popup-y
              :width 400
              :anchor 'top left')
  (networker))
