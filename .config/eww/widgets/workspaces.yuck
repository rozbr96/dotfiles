
(defvar active-workspace-id 1)

(defvar active-workspaces '[]')

(defwidget workspace [?name id]
  (eventbox
    :cursor 'pointer'
    :class 'workspace ${active-workspace-id == id ? "active" : ""}'
    (button
      :height main-bar-height
      :width main-bar-height
      :onclick `hyprctl dispatch 'hl.dsp.focus({ workspace = ${id} })'`
      {name ?: id})))

(defwidget workspaces []
  (eventbox
    :onscroll `echo "{}" | sed s/down/m+1/ | sed s/up/m-1/ | xargs -I X hyprctl dispatch 'hl.dsp.focus({ workspace = "X" })'`
    (box
      :orientation 'horizontal'
      :space-evenly false
      (for workspace in active-workspaces
        (workspace
          :id {workspace.id}
          :name {workspace.name})))))
